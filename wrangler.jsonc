// Publicación en Cloudflare (Workers con archivos estáticos). Cada push a main se despliega solo.
{
  "name": "exponencialesfirm-web",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": ".",
    // Las rutas que no existen muestran 404.html con estado 404
    "not_found_handling": "404-page",
    // /formacion sirve formacion.html
    "html_handling": "auto-trailing-slash"
  }
}
